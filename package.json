{
  "name": "dsh-sd-bridge-guard",
  "version": "1.0.3-mac.1",
  "description": "DeepSeek Harness 插件：本机 Stable Diffusion 生图九件套（文生图/图生图/蒙版重绘/只生成脚本/双版本对齐脚本/C 档本地注入命令/模型清单/服务管理/完整性检测）+ 违规分流协议 + C 档选项表（A 档出图后罗列模型/LoRA/比例等，一句话即可重出图）；C 档蒙版支持鼠标手绘。跨机器零适配——SD 目录自动探测，找不到可一键自举安装，产物目录自动落在会话工作区。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "stable-diffusion",
    "automatic1111",
    "txt2img",
    "img2img",
    "image-generation",
    "guard"
  ],
  "type": "module",
  "main": "sd-bridge.js",
  "files": [
    "sd-bridge.js",
    "sd-direct.ps1",
    "sd-inject.ps1",
    "sd-auto-mask.py",
    "sd-mask-qa.py",
    "install-sd.ps1",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/",
    "publish-npm.ps1",
    "manifest.json",
    "verify-integrity.mjs",
    "test-region-mask.ps1",
    "test-mask-qa.ps1",
    "test-vlm-cleanup.ps1",
    "test-automask-retry.ps1",
    "test-vram-release.ps1",
    "test-trailing-comma.ps1",
    "install-sd-macos.sh",
    "sd-direct.sh",
    "fix-macho-zerofill.py"
  ],
  "scripts": {
    "test": "node smoke-skill.mjs && node test-install-record.mjs && node test-settings.mjs && node test-install-catalog.mjs",
    "test:smoke": "node smoke-skill.mjs",
    "test:mask": "powershell -NoProfile -ExecutionPolicy Bypass -File test-region-mask.ps1",
    "test:qa": "powershell -NoProfile -ExecutionPolicy Bypass -File test-mask-qa.ps1",
    "test:record": "node test-install-record.mjs",
    "test:settings": "node test-settings.mjs",
    "test:catalog": "node test-install-catalog.mjs",
    "acceptance": "node acceptance.mjs",
    "test:vlm": "powershell -NoProfile -ExecutionPolicy Bypass -File test-vlm-cleanup.ps1",
    "test:automask": "powershell -NoProfile -ExecutionPolicy Bypass -File test-automask-retry.ps1",
    "test:vram": "powershell -NoProfile -ExecutionPolicy Bypass -File test-vram-release.ps1",
    "test:comma": "powershell -NoProfile -ExecutionPolicy Bypass -File test-trailing-comma.ps1",
    "manifest": "node gen-manifest.mjs",
    "manifest:check": "node gen-manifest.mjs --check",
    "integrity": "node verify-integrity.mjs",
    "integrity:remote": "node verify-integrity.mjs --remote",
    "prepublishOnly": "node gen-manifest.mjs && node gen-manifest.mjs --check"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savinglighting/dsh-sd-bridge-guard.git"
  },
  "homepage": "https://github.com/savinglighting/dsh-sd-bridge-guard#readme",
  "bugs": {
    "url": "https://github.com/savinglighting/dsh-sd-bridge-guard/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
